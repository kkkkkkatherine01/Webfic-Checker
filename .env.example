# Copy to .env and fill in. .env is git-ignored — never commit real keys.

WEBFIC_DATABASE_URL=postgresql+asyncpg://webfic:webfic@localhost:5432/webfic

# Platform LLM (DeepSeek, OpenAI-compatible protocol)
WEBFIC_LLM_BASE_URL=https://api.deepseek.com
WEBFIC_LLM_API_KEY=
WEBFIC_LLM_EXTRACT_MODEL=deepseek-flash
WEBFIC_LLM_REASON_MODEL=deepseek-v4-pro

# Extra request fields per tier, as JSON. The extract default switches off DeepSeek's
# thinking mode; set to {} for providers that don't accept this field.
# WEBFIC_LLM_EXTRACT_EXTRA={"thinking": {"type": "disabled"}}
# WEBFIC_LLM_REASON_EXTRA={}
